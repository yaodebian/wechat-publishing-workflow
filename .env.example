# Choose one authentication method.
# Method 1: paste a current access token directly.
WECHAT_ACCESS_TOKEN=

# Method 2: let the script request an access token on each run.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Optional defaults used when article front matter or command options do not override them.
WECHAT_AUTHOR=
WECHAT_DEFAULT_COVER=
WECHAT_TEMPLATE=./templates/default.html
WECHAT_CONTENT_SOURCE_URL=

# Optional: point to Chrome/Chromium when it is not in a common install location.
CHROME_PATH=

# Keep the official host unless a local mock server is being used for tests.
WECHAT_API_BASE_URL=https://api.weixin.qq.com
